{
  'compilerOptions': {
    'target': 'ES2020',
    'module': 'ESNext',
    'moduleResolution': 'node',
    'strict': true,
    'jsx': 'preserve',
    'esModuleInterop': true,
    'skipLibCheck': true,
    'forceConsistentCasingInFileNames': true,
    'resolveJsonModule': true,
    'isolatedModules': true,
    'noEmit': true,
    'baseUrl': '.',
    'paths': {
      '@/*': ['./panel/*']
    }
  },
  'include': ['panel/**/*.js', 'server/**/*.js'],
  'exclude': ['node_modules', 'dist']
}
